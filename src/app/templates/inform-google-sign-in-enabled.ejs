<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Google Sign-In Enabled - PH Healthcare</title>
</head>

<body style="
    margin:0;
    padding:10px;
    background:#eff6ff;
    font-family:Arial, Helvetica, sans-serif;
    color:#1e293b;
">

    <div style="
        max-width:620px;
        margin:40px auto;
        padding:0 15px;
    ">

        <!-- Main Card -->
        <div style="
            background:#ffffff;
            border-radius:16px;
            overflow:hidden;
            box-shadow:0 8px 30px rgba(15, 23, 42, 0.08);
        ">

            <!-- Header -->
            <div style="
                background:#2563eb;
                padding:35px 30px;
                text-align:center;
            ">

                <!-- Logo -->
                <div style="
                    width:56px;
                    height:56px;
                    margin:0 auto 12px;
                    background:#ffffff;
                    border-radius:14px;
                    line-height:56px;
                    font-size:28px;
                ">
                    🩺
                </div>

                <h1 style="
                    margin:0;
                    color:#ffffff;
                    font-size:26px;
                    font-weight:700;
                ">
                    PH Healthcare
                </h1>

                <p style="
                    margin:8px 0 0;
                    color:#dbeafe;
                    font-size:14px;
                ">
                    Healthcare Management System
                </p>

            </div>

            <!-- Content -->
            <div style="
                padding:40px 35px 20px;
                text-align:center;
            ">

                <!-- Notification Icon -->
                <div style="
                    width:64px;
                    height:64px;
                    margin:0 auto 20px;
                    background:#dbeafe;
                    border-radius:50%;
                    line-height:64px;
                    color:#2563eb;
                    font-size:30px;
                    font-weight:bold;
                ">
                    ✓
                </div>

                <!-- Heading -->
                <h2 style="
                    margin:0 0 12px;
                    color:#0f172a;
                    font-size:24px;
                    line-height:1.3;
                ">
                    Google Sign-In Enabled
                </h2>

                <!-- Greeting -->
                <p style="
                    margin:0 0 10px;
                    color:#334155;
                    font-size:15px;
                    line-height:1.6;
                ">
                    Hi <strong><%= name %></strong>,
                </p>

                <!-- Description -->
                <p style="
                    max-width:500px;
                    margin:0 auto;
                    color:#64748b;
                    font-size:15px;
                    line-height:1.7;
                ">
                    Your PH Healthcare account has been successfully
                    connected with Google. You can now sign in to your
                    account using your Google account.
                </p>

                <!-- Login Information -->
                <div style="
                    margin:30px 0 0;
                    padding:20px;
                    background:#eff6ff;
                    border:1px solid #bfdbfe;
                    border-radius:10px;
                    text-align:left;
                ">

                    <p style="
                        margin:0 0 12px;
                        color:#1e40af;
                        font-size:14px;
                        font-weight:600;
                    ">
                        Sign-in information
                    </p>

                    <p style="
                        margin:0 0 8px;
                        color:#64748b;
                        font-size:13px;
                        line-height:1.6;
                    ">
                        <strong style="color:#334155;">
                            Email:
                        </strong>
                        <%= email %>
                    </p>

                    <p style="
                        margin:0;
                        color:#64748b;
                        font-size:13px;
                        line-height:1.6;
                    ">
                        <strong style="color:#334155;">
                            Sign-in method:
                        </strong>
                        Google
                    </p>

                </div>

                <!-- Credentials Account Notice -->
                <div style="
                    margin-top:20px;
                    padding:18px 20px;
                    background:#f8fafc;
                    border-left:4px solid #2563eb;
                    border-radius:6px;
                    text-align:left;
                ">

                    <p style="
                        margin:0;
                        color:#475569;
                        font-size:13px;
                        line-height:1.7;
                    ">
                        <strong style="color:#1e40af;">
                            Your password is still active.
                        </strong>
                        Your existing email and password credentials
                        have not been removed or changed. You can continue
                        to use your credentials-based login whenever you
                        prefer.
                    </p>

                </div>

                <!-- Security Notice -->
                <div style="
                    margin-top:25px;
                    padding-top:20px;
                    border-top:1px solid #e2e8f0;
                    text-align:left;
                ">

                    <p style="
                        margin:0;
                        color:#64748b;
                        font-size:13px;
                        line-height:1.7;
                    ">
                        <strong style="color:#334155;">
                            Wasn't you?
                        </strong>
                        If you did not connect or use Google sign-in
                        with your PH Healthcare account, please secure
                        your account and contact our support team
                        immediately.
                    </p>

                </div>

            </div>

            <!-- Footer -->
            <div style="
                padding:24px 30px;
                background:#f8fafc;
                border-top:1px solid #e2e8f0;
                text-align:center;
            ">

                <p style="
                    margin:0 0 7px;
                    color:#334155;
                    font-size:13px;
                    font-weight:600;
                ">
                    PH Healthcare Management System
                </p>

                <p style="
                    margin:0;
                    color:#94a3b8;
                    font-size:12px;
                    line-height:1.5;
                ">
                    This is an automated security notification.
                    Please do not reply.
                </p>

                <p style="
                    margin:10px 0 0;
                    color:#94a3b8;
                    font-size:11px;
                ">
                    &copy; <%= new Date().getFullYear() %> PH Healthcare.
                    All rights reserved.
                </p>

            </div>

        </div>

    </div>

</body>
</html>