<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Doctor Application Update - PH Healthcare</title>
</head>

<body style="
    margin:0;
    padding:10px;
    background:#fef2f2;
    font-family:Arial, Helvetica, sans-serif;
    color:#1e293b;
">

    <div style="
        max-width:620px;
        margin:40px auto;
        padding:0 15px;
    ">

        <!-- Main Card -->
        <div style="
            background:#ffffff;
            border-radius:16px;
            overflow:hidden;
            box-shadow:0 8px 30px rgba(15, 23, 42, 0.08);
        ">

            <!-- Header -->
            <div style="
                background:#dc2626;
                padding:35px 30px;
                text-align:center;
            ">

                <!-- Logo -->
                <div style="
                    width:56px;
                    height:56px;
                    margin:0 auto 12px;
                    background:#ffffff;
                    border-radius:14px;
                    line-height:56px;
                    font-size:28px;
                ">
                    🩺
                </div>

                <h1 style="
                    margin:0;
                    color:#ffffff;
                    font-size:26px;
                    font-weight:700;
                ">
                    PH Healthcare
                </h1>

                <p style="
                    margin:8px 0 0;
                    color:#fee2e2;
                    font-size:14px;
                ">
                    Healthcare Management System
                </p>

            </div>

            <!-- Content -->
            <div style="padding:40px 35px;">

                <!-- Greeting -->
                <p style="
                    margin:0 0 8px;
                    color:#334155;
                    font-size:15px;
                    line-height:1.6;
                ">
                    Hi <strong><%= name %></strong>,
                </p>

                <!-- Heading -->
                <h2 style="
                    margin:0 0 15px;
                    color:#991b1b;
                    font-size:24px;
                    line-height:1.3;
                ">
                    Doctor Application Update
                </h2>

                <!-- Description -->
                <p style="
                    margin:0;
                    color:#64748b;
                    font-size:15px;
                    line-height:1.7;
                ">
                    Thank you for your interest in joining PH Healthcare
                    as a doctor. After carefully reviewing your application,
                    we are unable to approve your application at this time.
                </p>

                <!-- Status -->
                <div style="
                    margin:25px 0;
                    padding:20px;
                    text-align:center;
                    background:#fef2f2;
                    border:1px solid #fecaca;
                    border-radius:12px;
                ">

                    <p style="
                        margin:0 0 8px;
                        color:#64748b;
                        font-size:13px;
                    ">
                        Application Status
                    </p>

                    <p style="
                        margin:0;
                        color:#dc2626;
                        font-size:22px;
                        font-weight:700;
                    ">
                        ✕ REJECTED
                    </p>

                </div>

                <!-- Rejection Reason -->
                <div style="
                    margin:25px 0 0;
                    padding:18px;
                    background:#f8fafc;
                    border:1px solid #e2e8f0;
                    border-radius:8px;
                ">

                    <p style="
                        margin:0 0 8px;
                        color:#334155;
                        font-size:14px;
                        font-weight:700;
                    ">
                        Reason for Rejection
                    </p>

                    <p style="
                        margin:0;
                        color:#64748b;
                        font-size:13px;
                        line-height:1.7;
                    ">
                        <%= reason %>
                    </p>

                </div>

                <!-- Email Information -->

                <!-- Next Steps -->
                <div style="
                    margin-top:25px;
                    padding:18px;
                    background:#fff7ed;
                    border-left:4px solid #f97316;
                    border-radius:6px;
                ">

                    <p style="
                        margin:0 0 8px;
                        color:#9a3412;
                        font-size:14px;
                        font-weight:700;
                    ">
                        What can you do next?
                    </p>

                    <p style="
                        margin:0;
                        color:#475569;
                        font-size:13px;
                        line-height:1.7;
                    ">
                        Please review the reason provided above and make
                        any necessary corrections or updates. If you believe
                        this decision was made in error, you may contact our
                        support team for further assistance.
                    </p>

                </div>

                <!-- Support CTA -->

                <!-- Closing Message -->
                <div style="
                    margin-top:25px;
                    padding-top:20px;
                    border-top:1px solid #e2e8f0;
                ">

                    <p style="
                        margin:0;
                        color:#64748b;
                        font-size:13px;
                        line-height:1.7;
                    ">
                        We appreciate your interest in PH Healthcare and
                        encourage you to address the issues mentioned in
                        the review if you wish to apply again in the future.
                    </p>

                </div>

            </div>

            <!-- Footer -->
            <div style="
                padding:24px 30px;
                background:#f8fafc;
                border-top:1px solid #e2e8f0;
                text-align:center;
            ">

                <p style="
                    margin:0 0 7px;
                    color:#334155;
                    font-size:13px;
                    font-weight:600;
                ">
                    PH Healthcare Management System
                </p>

                <p style="
                    margin:0;
                    color:#94a3b8;
                    font-size:12px;
                    line-height:1.5;
                ">
                    This is an automated email. Please do not reply.
                </p>

                <p style="
                    margin:10px 0 0;
                    color:#94a3b8;
                    font-size:11px;
                ">
                    &copy; <%= new Date().getFullYear() %> PH Healthcare.
                    All rights reserved.
                </p>

            </div>

        </div>

    </div>

</body>
</html>